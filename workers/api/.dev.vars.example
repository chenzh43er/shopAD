# Local development secrets — copy from this example
# 分工：本文件仅 Worker；前端只用 VITE_SUPABASE_ANON_KEY；落地页用 storefront 的 DATABASE_URL
SUPABASE_URL=
# New-style keys from Dashboard → Project Settings → API Keys
SUPABASE_ANON_KEY=sb_publishable_...
# 仅服务端；勿复制到 apps/web 或 product-1
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Optional (legacy HS256 verify); not required when using auth.getUser
SUPABASE_JWT_SECRET=

# Optional Upstash Redis（Free 测试即可）。关掉：REDIS_ENABLED=false 或不填 URL/TOKEN
# REDIS_ENABLED 也可在 wrangler.toml [vars] 里设；这里覆盖本地
REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
